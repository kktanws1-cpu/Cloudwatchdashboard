Cell&gt;&lt;mxCell id="10" value="(1) GSIB / WOG Notebook&amp;lt;br&amp;gt;(Intranet staff on internet machine)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=9;fontStyle=0;verticalAlign=middle;align=center;" vertex="1" parent="1"&gt;&lt;mxGeometry x="50" y="151" width="216" height="101" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="11" value="(2) WOG Domain&amp;lt;br&amp;gt;mailpit.example.gov.sg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F497D;fontSize=10;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"&gt;&lt;mxGeometry x="310" y="151" width="216" height="101" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="12" value="(3) Route 53&amp;lt;br&amp;gt;DNS to CloudFront" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8D5FF;strokeColor=#8C4FFF;fontColor=#44007F;fontSize=10;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"&gt;&lt;mxGeometry x="569" y="151" width="216" height="101" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="13" value="(4) CloudFront Distribution&amp;lt;br&amp;gt;(Mailpit CDN)&amp;lt;br&amp;gt;+ Shared WAF WebACL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFD5EA;strokeColor=#E7157B;fontColor=#8B0040;fontSize=10;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"&gt;&lt;mxGeometry x="828" y="151" width="216" height="101" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="14" value="(5) Mailpit EC2&amp;lt;br&amp;gt;Elastic IP : Port 8025&amp;lt;br&amp;gt;Email Capture" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE5CC;strokeColor=#D86613;fontColor=#7A3700;fontSize=10;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"&gt;&lt;mxGeometry x="1346" y="151" width="259" height="101" as="geometry" /&gt;&lt;/mxCell&gt;&lt;mxCell id="20" value="Shared WAF WebACL&amp;lt;br&amp;gt;- Same WebACL as court CDNs&amp;lt;br&amp;gt;- Default: BLOCK&amp;lt;br&amp;gt