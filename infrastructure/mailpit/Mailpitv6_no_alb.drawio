        <!-- ===== Mailpit Internet Access (intranet staff on internet machines) ===== -->

        <!-- WOG Domain entry point (internet-accessible DNS for Mailpit) -->
        <mxCell id="mailpit-wog-domain" parent="1" style="html=1;rounded=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Tahoma;fontStyle=1;verticalAlign=middle;align=center;whiteSpace=wrap;" value="WOG Domain&#xa;mailpit.example.gov.sg" vertex="1">
          <mxGeometry x="640" y="-510" width="190" height="56" as="geometry"/>
        </mxCell>

        <!-- Route 53 / DNS for Mailpit WOG domain -->
        <mxCell id="mailpit-route53" parent="1" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeColor=#ffffff;pointerEvents=1;fontSize=11;fontFamily=Tahoma;fontColor=#333333;fontStyle=1;spacing=0;strokeOpacity=100;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#8c4fff;strokeWidth=2.3;" value="Route 53&#xa;(WOG Domain)" vertex="1">
          <mxGeometry x="845" y="-495" width="49" height="49" as="geometry"/>
        </mxCell>

        <!-- Arrow: Intranet staff (internet machine) → WOG Domain -->
        <mxCell id="mailpit-edge-user-wog" edge="1" parent="1" source="spCD5IdJFISM8aWQ-gpm-111" target="mailpit-wog-domain" style="html=1;jettySize=18;whiteSpace=wrap;fontSize=11;strokeColor=#0050ef;strokeWidth=2;rounded=1;arcSize=12;edgeStyle=orthogonalEdgeStyle;startArrow=none;endArrow=block;endFill=1;fontFamily=Tahoma;" value="HTTPS">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow: WOG Domain → Route 53 -->
        <mxCell id="mailpit-edge-wog-r53" edge="1" parent="1" source="mailpit-wog-domain" target="mailpit-route53" style="html=1;jettySize=18;whiteSpace=wrap;fontSize=11;strokeColor=#8c4fff;strokeWidth=1.5;rounded=1;arcSize=12;edgeStyle=orthogonalEdgeStyle;startArrow=none;endArrow=block;endFill=1;fontFamily=Tahoma;" value="">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CloudFront distribution for Mailpit (internet zone) -->
        <mxCell id="mailpit-cloudfront" parent="1" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeColor=#ffffff;pointerEvents=1;fontSize=11;fontFamily=Tahoma;fontColor=#333333;fontStyle=1;spacing=0;strokeOpacity=100;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#e7157b;strokeWidth=2.3;" value="Mailpit CDN&#xa;(CloudFront)" vertex="1">
          <mxGeometry x="572" y="360" width="49" height="49" as="geometry"/>
        </mxCell>

        <!-- AWS WAF on CloudFront (restricts to intranet egress IPs) -->
        <mxCell id="mailpit-waf" parent="1" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeColor=#ffffff;pointerEvents=1;fontSize=11;fontFamily=Tahoma;fontColor=#333333;fontStyle=1;spacing=0;strokeOpacity=100;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#dd344c;strokeWidth=2.3;" value="AWS WAF&#xa;(Intranet IP&#xa;Allowlist)" vertex="1">
          <mxGeometry x="657" y="360" width="49" height="49" as="geometry"/>
        </mxCell>

        <!-- Arrow: Route 53 → CloudFront -->
        <mxCell id="mailpit-edge-r53-cf" edge="1" parent="1" source="mailpit-route53" target="mailpit-cloudfront" style="html=1;jettySize=18;whiteSpace=wrap;fontSize=11;strokeColor=#0050ef;strokeWidth=2;rounded=1;arcSize=12;edgeStyle=orthogonalEdgeStyle;startArrow=none;endArrow=block;endFill=1;fontFamily=Tahoma;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="869" y="-390"/>
              <mxPoint x="869" y="340"/>
              <mxPoint x="596" y="340"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Firewall rule note: open HTTPS from CloudFront to Mailpit ALB -->
        <mxCell id="mailpit-fw-rule" parent="1" style="html=1;rounded=1;arcSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Tahoma;fontStyle=0;verticalAlign=middle;align=center;whiteSpace=wrap;" value="Firewall Rule&#xa;Allow HTTPS (443)&#xa;CloudFront IPs &gt; EC2:8025&#xa;(no ALB needed)" vertex="1">
          <mxGeometry x="1455" y="420" width="195" height="65" as="geometry"/>
        </mxCell>
        <!-- Arrow: CloudFront → Mailpit ALB (crosses firewall - dashed blue line) -->
        <mxCell id="mailpit-edge-cf-ec2" edge="1" parent="1" source="mailpit-cloudfront" target="mailpit-ec2-001" style="html=1;jettySize=18;whiteSpace=wrap;fontSize=11;fontFamily=Tahoma;strokeColor=#0050ef;strokeWidth=2.5;rounded=1;arcSize=12;edgeStyle=orthogonalEdgeStyle;startArrow=none;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;" value="HTTPS (443) direct to EC2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="596" y="450"/>
              <mxPoint x="2439" y="450"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Label: Internet machine note for clarity -->
        <mxCell id="mailpit-note-internet" parent="1" style="html=1;rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;fontFamily=Tahoma;fontStyle=2;verticalAlign=middle;align=center;whiteSpace=wrap;" value="Intranet staff use internet&#xa;notebook to access Mailpit&#xa;via WOG domain + CloudFront" vertex="1">
          <mxGeometry x="370" y="-510" width="195" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== End Mailpit Internet Access ===== -->
